# First-time setup:
# Copy to .env (cp env.example .env)
# Replace <YOUR-BOT-TOKEN> with the Discord Bot Token ( see: https://discord.com/developers/applications )
DISCORD_MOD_BOT_TOKEN="<YOUR-BOT-TOKEN>"


# Alert-grading report (see docs/handoffs/2026-09-04-alert-grades-report.md).
# The ledger is written by pytrade-bot; this bot only reads it.
MOD_BOT_ALERT_GRADES_DIR="~/pytrade-signal-grades"
# development -> #test, production -> #general. Production is opt-in:
# any other value routes to the dev channel.
MOD_BOT_ALERT_GRADES_ENV="development"
MOD_BOT_ALERT_GRADES_CHANNEL_DEV="1507130942488313998"
MOD_BOT_ALERT_GRADES_CHANNEL_PROD="1493353808900784251"
# v2 (default) sends the day's post.json as a Components V2 message when it
# is sendable; classic forces the phase-1 embeds. A bad V2 render can only be
# fixed by delete and repost, so this is the switch to flip while checking one.
MOD_BOT_ALERT_GRADES_LAYOUT="v2"
# Required for /grade to appear as a slash command.
MOD_BOT_SYNC_GUILD_ID=""
